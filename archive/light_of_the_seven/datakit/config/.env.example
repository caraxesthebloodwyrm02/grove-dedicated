# Production-ready environment template
# Copy to `.env` (DO NOT commit `.env`) and fill in values.
# Keep secrets in a secret manager in real production.

# ----------------------------
# App / Runtime
# ----------------------------
APP_ENV=development
APP_NAME=datakit
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# If you expose any HTTP service (not required for CLI usage)
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000

# Determinism / reproducibility (if relevant)
PYTHONHASHSEED=0

# ----------------------------
# OpenAI / LLM Providers
# ----------------------------
# Never hardcode API keys in code or commit them to git.
# OpenAI
OPENAI_API_KEY=
# Optional: explicitly scope usage to a specific organization/project when needed
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Recommended model knobs (your app may ignore these unless wired up)
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=30

# If you use streaming in your app
OPENAI_STREAM=false

# ----------------------------
# External APIs (example: YouTube)
# ----------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ----------------------------
# Caching / Storage
# ----------------------------
# Local cache directory (ensure writable in container/host)
DATAKIT_CACHE_DIR=./artifacts/cache

# If you add Redis later:
# REDIS_URL=redis://localhost:6379/0

# ----------------------------
# Rate limiting / quotas (app-side)
# ----------------------------
# These are app-enforced safeguards (not OpenAI account limits)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ----------------------------
# Observability
# ----------------------------
# Basic structured logging toggle (if implemented)
LOG_FORMAT=json

# OpenTelemetry (if implemented)
OTEL_SERVICE_NAME=datakit
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Sentry (if implemented)
SENTRY_DSN=

# ----------------------------
# Security
# ----------------------------
# If you add auth to a web API:
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=

# ----------------------------
# Notes
# ----------------------------
# - Prefer staging vs production projects and separate keys per environment.
# - Rotate keys regularly.
# - Keep `.env` out of source control.
