{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Swift & Cognitive Framework Concept Mappings",
  "description": "Maps abstract AI and cognitive concepts to relatable anchors and analogies.",
  "type": "object",
  "properties": {
    "adaptive_learning_system": {
      "type": "object",
      "properties": {
        "abstract": {
          "type": "string",
          "description": "Formal definition of adaptive learning systems."
        },
        "anchors": {
          "type": "object",
          "description": "Relatable examples or analogies for the concept.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string",
                "description": "Explanation using this anchor."
              },
              "user_check": {
                "type": "string",
                "description": "Question to verify if the user relates to this anchor."
              }
            },
            "required": [
              "script"
            ]
          }
        },
        "ai_link": {
          "type": "string",
          "description": "Key in ai_links.json for deep-dive connections."
        }
      },
      "required": [
        "abstract",
        "anchors"
      ]
    },
    "reinforcement_learning": {
      "type": "object",
      "properties": {
        "abstract": {
          "type": "string",
          "description": "Formal definition of reinforcement learning."
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string"
              },
              "user_check": {
                "type": "string"
              }
            },
            "required": [
              "script"
            ]
          }
        },
        "ai_link": {
          "type": "string"
        }
      },
      "required": [
        "abstract",
        "anchors"
      ]
    },
    "neural_architecture_search": {
      "type": "object",
      "properties": {
        "abstract": {
          "type": "string",
          "description": "Formal definition of neural architecture search."
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string"
              },
              "user_check": {
                "type": "string"
              }
            },
            "required": [
              "script"
            ]
          }
        },
        "ai_link": {
          "type": "string"
        }
      },
      "required": [
        "abstract",
        "anchors"
      ]
    },
    "user_model": {
      "type": "object",
      "properties": {
        "abstract": {
          "type": "string",
          "description": "Formal definition of user modeling."
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string"
              },
              "user_check": {
                "type": "string"
              }
            },
            "required": [
              "script"
            ]
          }
        },
        "ai_link": {
          "type": "string"
        }
      },
      "required": [
        "abstract",
        "anchors"
      ]
    },
    "energy_function": {
      "type": "object",
      "properties": {
        "abstract": {
          "type": "string",
          "description": "A scalar function defining the 'cost' or 'loss' landscape of a model (Energy-Based Models)."
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string"
              },
              "user_check": {
                "type": "string"
              }
            },
            "required": [
              "script"
            ]
          }
        },
        "ai_link": {
          "type": "string"
        }
      },
      "required": [
        "abstract",
        "anchors"
      ]
    },
    "momentum_optimizer": {
      "type": "object",
      "properties": {
