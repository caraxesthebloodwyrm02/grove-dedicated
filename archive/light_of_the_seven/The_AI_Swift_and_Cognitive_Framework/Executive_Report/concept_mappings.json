  "additionalProperties": false,
  "examples": [
    {
      "adaptive_learning_system": {
        "abstract": "A system that adjusts its teaching method based on user performance and feedback.",
        "anchors": {
          "streaming_service": {
            "script": "An adaptive learning system is like a streaming service that recommends shows based on what you've watched before. It learns from your interactions and adjusts its suggestions to match your preferences.",
            "user_check": "Do you use streaming services like Netflix or Spotify? (yes/no)"
          },
          "personal_trainer": {
            "script": "Think of an adaptive learning system like a personal trainer. It observes your performance, identifies areas for improvement, and tailors exercises to help you progress.",
            "user_check": "Have you ever worked with a personal trainer or coach? (yes/no)"
          }
        },
        "ai_link": "adaptive_learning_streaming"
      }
    }
  ]
