[{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "location": { "type": "string" },
    "experiences": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["drives_car", "cleans_room", "uses_gps"]
      }
    },
    "knowledge_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["newtons_laws", "qubits", "boolean_algebra"]
      }
    }
  },
  "required": ["name", "experiences"],
  "examples": [{
    "name": "Matilde",
    "location": "Marseille",
    "experiences": ["drives_car", "cleans_room"],
    "knowledge_gaps": ["newtons_laws", "qubits"]
  }]
}]