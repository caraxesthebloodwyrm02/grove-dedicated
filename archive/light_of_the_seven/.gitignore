# Cache directories
.cache/
__pycache__/
.pytest_cache/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
test-results/

# ============================================================================
# Git Configuration Files (tracked but with specific handling)
# ============================================================================
# These should be committed with care:
# .gitattributes - for line ending and file type handling
# .gitconfig - local user config (should NOT be committed)
# .gitmodules - for submodules
# .gitmessage - custom commit messages

# ============================================================================
# Exclusions (Force include)
# ============================================================================
# Uncomment to force include specific files that would otherwise be ignored
# !important.log
# !config/sample.json
# !docs/README.md

# ============================================================================
# End of .gitignore
# ============================================================================
