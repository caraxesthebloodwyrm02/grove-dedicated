# Coverage configuration for light_of_the_seven

[run]
source = src/light_of_the_seven
branch = True
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */.venv/*
    */venv/*

[report]
# Coverage thresholds
precision = 2
show_missing = True
skip_covered = False

# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    @overload

[html]
directory = htmlcov

[xml]
output = coverage.xml

