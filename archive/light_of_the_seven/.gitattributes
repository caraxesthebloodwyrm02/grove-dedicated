# ============================================================================
# Git Attributes for GRID Project
# ============================================================================

# Auto-detect text files and normalize line endings
* text=auto

# Explicitly declare text files
*.gitattributes text
*.gitignore text
*.md text
*.py text
*.js text
*.ts text
*.json text
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Declare binary files
*.pkl binary
*.pickle binary
*.model binary
*.h5 binary
*.hdf5 binary
*.pb binary
*.onnx binary
*.tflite binary
*.pt binary
*.pth binary
*.bin binary
*.safetensors binary
*.gguf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.7z binary

# Large File Storage (if using Git LFS)
# *.model filter=lfs diff=lfs merge=lfs -text
# *.pkl filter=lfs diff=lfs merge=lfs -text
# *.h5 filter=lfs diff=lfs merge=lfs -text

# Custom diff drivers
# *.py diff=python
# *.json diff=json

# Export ignore for archives
.gitignore export-ignore
.gitattributes export-ignore
.env* export-ignore
__pycache__/ export-ignore
node_modules/ export-ignore

* text=auto eol=lf
*.wav binary
*.mp4 binary
